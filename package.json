{
  "name": "slacken",
  "version": "0.1.0",
  "private": true,
  "description": "A calmer reading layer for the macOS Slack desktop app: condenses padded messages and evens out tone, using claude -p.",
  "type": "module",
  "bin": {
    "slacken": "./bin/slacken.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/slacken.js start",
    "doctor": "node ./bin/slacken.js doctor",
    "test": "node --test test/unit.mjs test/batch.mjs test/agent.mjs test/e2e.mjs",
    "test:fast": "node --test test/unit.mjs test/batch.mjs test/agent.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
