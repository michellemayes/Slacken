{
  "name": "slackcensor",
  "version": "0.1.0",
  "private": true,
  "description": "Softens overly urgent or aggressive incoming Slack messages in the macOS Slack desktop app, using claude -p.",
  "type": "module",
  "bin": {
    "slackcensor": "./bin/slackcensor.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/slackcensor.js start",
    "doctor": "node ./bin/slackcensor.js doctor",
    "test": "node --test test/unit.mjs test/batch.mjs test/e2e.mjs",
    "test:fast": "node --test test/unit.mjs test/batch.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
